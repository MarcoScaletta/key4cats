\sorts{
    \generic Z;
}

\schemaVariables{
    \modalOperator {diamond} #localJudge;
    \modalOperator {box} #globalJudge;
    \modalOperator {box, diamond} #anyJudge;
    \formula post;
    \program Variable #loc;
    \program SimpleExpression #se;
    \program Expression #e;
    \program Statement #s, #s0, #s1;
    \program NonSimpleExpression #nse;
    \program [list] Statement #slist, #slist0;
    \program Variable #boolv, #v0, #v, #a; // #v, #v0, #v1, #v2, #boolv, #a, #a0, #a1;
    \program Type #t, #t2;
    \program SimpleExpressionNonFloatDouble #senf, #senf0, #senf1;
    \program LeftHandSide #lhs, #lhs0, #lhs1, #lhs2;
    \program JavaBooleanExpression #exBool;

    \skolemTerm Z observingSk;



    \variable int oId;
}




\rules{

    // elim. schematic trace when single update event left and schematic trace is in chop with single trace event

    // elimination of pop event during update application to program variable
    elimPopEv{
        \schemaVar \update u, u2;
        \schemaVar \term int i;
        \schemaVar \program Variable pv;
        \schemaVar \term MethodName m;
        \find({u;\popEv(m,i)}pv)
        \replacewith({u}pv)
        \heuristics(update_elim)
    };

    // elimination of return event during update application to program variable
    elimRetEv{
        \schemaVar \update u, u2;
        \schemaVar \term int i;
        \schemaVar \program Variable pv;
        \find({u;\retEv(i)}pv)
        \replacewith({u}pv)
        \heuristics(update_elim)
    };

    // elimination of start event during update application to program variable
    elimStarEv{
        \schemaVar \update u, u2;
        \schemaVar \term int i;
        \schemaVar \program Variable pv;
        \schemaVar \term MethodName m;
        \find({u;\startEv(m,i)}pv)
        \replacewith({u}pv)
        \heuristics(update_elim)
    };

    elimSchemTrRunEv{
        \schemaVar \formula phi,schemTr;
        \schemaVar \program MethodName methodName;
        \schemaVar \update u;
        \schemaVar \term int i;
        \schemaVar \term boolean sync;

        \find(==> {u;\runEv(methodName,i,sync)}\<{}\>(phi ** schemTr))
        \varcond(\isSchematicTraceOverM(schemTr, methodName))
        \replacewith(==> {u;\runEv(methodName,i,sync)}\<{}\>(phi))
        \heuristics(simplify)
    };

    closureRunEvNonMatchingSchemTr{
        \schemaVar \formula phi,schemTr;
        \schemaVar \program MethodName methodName;
        \schemaVar \term int i;
        \schemaVar \term boolean sync;

        \find(==> {\runEv(methodName,i,sync)}\<{}\>(schemTr))
        \varcond(\not\isSchematicTraceOverM(schemTr, methodName))
        \closegoal
        \heuristics(closure)
    };

    // elementary update application on assigned program variable
    applyUpdateOnSamePV{
        \schemaVar \update u, u2;
        \schemaVar \program Variable pv;
        \schemaVar \term Z t;
        \find({u;pv:=t}pv)
        \replacewith({u}t)
        \heuristics(update_apply)
    };

    // elementary update application on program variable different from the assigned one
    applyUpdateOnDifferentPV{
        \schemaVar \update u, u2;
        \schemaVar \program Variable pv,pv1;
        \schemaVar \term Z t;
        \find({u;pv:=t}pv1)
        \varcond(\different(pv,pv1))
        \replacewith({u}pv1)
        \heuristics(update_apply)
    };

    // update application on rigid term
    applyOnRigidTermCAT {
        \schemaVar \update u;
        \schemaVar \term any t, result;

        \find({u}t)
        \varcond(\applyUpdateOnRigid(u, t, result))

        \replacewith(result)

        \heuristics(update_apply)
    };

    // update application on rigid constant
    applyOnRigidConstant{

        \schemaVar \update u;
        \schemaVar \term [rigid] any t;

        \find({u}t)

        \replacewith(t)

        \heuristics(update_apply)
    };

}

\rules {


    // nested update to sequential update
    nestedUpdateToSeqUpdate{
        \schemaVar \update u, u2;
        \schemaVar \formula phi;
        \find(
            {u}{u2}phi
        )
        \replacewith(
            {u;u2}phi
        )
        \heuristics(update_join)
    };

    // trivial judgment with schematic trace
    trivialSchemTr {
        \schemaVar \update u;
        \find(==>{u}\<{}\>(~~))
        \closegoal
        \displayname "Trivial Schematic Trace"
        \heuristics(closure)
    };

    // left-side associativity with chops
    preAssociativityTraces1 {
        \schemaVar \formula phi,phi1,phi2,phi3;
        \find(phi ** (phi1 ** phi2))
        \replacewith((phi ** phi1) ** phi2)
        \heuristics(simplify)
        };

    // left-side associativity with chop and concatenation
    preAssociativityTraces2 {
        \schemaVar \formula phi,phi1,phi2,phi3;
        \find(phi ** (phi1 $. phi2))
        \replacewith((phi ** phi1) $. phi2)
        \heuristics(simplify)
    };


    // left-side associativity with concatenations
    // MANUAL
    preAssociativityTraces3 {
        \schemaVar \formula phi,phi1,phi2,phi3;
        \find(phi $. (phi1 $. phi2))
        \replacewith((phi $. phi1) $. phi2)
        \heuristics(simplify)
    };

    // left-side associativity with concatenation and chop
    // MANUAL
    preAssociativityTraces4 {
        \schemaVar \formula phi,phi1,phi2,phi3;
        \find(phi $. (phi1 ** phi2))
        \replacewith((phi $. phi1) ** phi2)
    };

    // right-side associativity with chops
    // MANUAL
    postAssociativityTraces1 {
        \schemaVar \formula phi,phi1,phi2,phi3;
        \find((phi ** phi1) ** phi2)
        \replacewith(phi ** (phi1 ** phi2))
//        \heuristics(simplify)
    };

    // right-side associativity with chop and concatenation
    // MANUAL
    postAssociativityTraces2 {
        \schemaVar \formula phi,phi1,phi2,phi3;
        \find((phi ** phi1) $. phi2)
        \replacewith(phi ** (phi1 $. phi2))
//        \heuristics(simplify)
    };


    // observation at the end of trace formula for judgment in consequent
    obsRChop{
        \schemaVar \formula phi;
        \schemaVar \formula #observation;
        \schemaVar \formula stateFml;
        \schemaVar \update u;
        \schemaVar \term int i;
        \schemaVar \term Z observed, observing;
        \find(==>{u}\<{}\>((phi ** #observation) $. `stateFml`))
        \varcond(\observationCondition(#observation, observed, observing))
        \replacewith(==>{u}\<{}\>(phi ** `stateFml`))
        \add(({u}observed) = observing ==>)
        \heuristics(simplify)
    };

    obsRConc{
        \schemaVar \formula phi;
        \schemaVar \formula #observation;
        \schemaVar \formula stateFml;
        \schemaVar \update u;
        \schemaVar \term int i;
        \schemaVar \term Z observed, observing;
        \find(==>{u}\<{}\>((phi $. #observation) $. `stateFml`))
        \varcond(\observationCondition(#observation, observed, observing))
        \replacewith(==>{u}\<{}\>(phi $. `stateFml`))
        \add(({u}observed) = observing ==>)
        \heuristics(simplify_prog)
    };

    make_obsL{
        \schemaVar \formula phi,phi1;
        \schemaVar \formula #observation;
        \schemaVar \formula stateFml;
        \schemaVar \update u,u1;
        \schemaVar \term int i;
        \schemaVar \term Z observed, observing;

        \find(==> {u1}\<{}\>(phi1))
                \varcond(\not\containsObservations(phi1))
        \addrules(

            // observation at the end of trace formula for judgment in antecedent
            obsLChop{
                \find({u}\<{}\>((phi ** #observation) $. `stateFml`)==>)
                \varcond(\observationCondition(#observation, observed, observing))
                \replacewith({u}\<{}\>(phi ** `stateFml`)==>)
                \add(({u}observed) = observing,stateFml ==>)
                \heuristics(observingInAnte)
            })
        \heuristics(concrete)
    };


    // observation inside trace formula for judgment in consequent
    interObsR{

        \schemaVar \formula tracePrefix, #tracePostfix, traceFull, #observation;
        \schemaVar \update updateFull,updatePrefix;
        \schemaVar \term Z #observed, #observing;
        \assumes({updatePrefix}\<{}\>(tracePrefix)==>)
        \find(==> {updateFull}\<{}\>(traceFull))
        \varcond(
            \interObs(updateFull, updatePrefix, traceFull, tracePrefix, #tracePostfix, #observed, #observing),
            \not\containsObservations(#tracePostfix))
        \replacewith(==> {updateFull}\<{}\>(tracePrefix ** #tracePostfix))
        \add(({updatePrefix}#observed) = #observing ==>)

        \heuristics(simplify)

    };

    // prove post state following chop, with no pending observations
    postStateChopSucc{
        \schemaVar \formula phi;
        \schemaVar \formula #observation;
        \schemaVar \formula #stateFml;
        \schemaVar \update u;
        \schemaVar \term int i;
        \find(==> {u}\<{}\>(phi ** `#stateFml`))
        \varcond(\postStateCondition(phi,#stateFml),\not\containsObservations(phi))
        \replacewith(==>#stateFml);
        \replacewith(==> {u}\<{}\>(phi))
        \heuristics(simplify)
    };

    // prove post state following concatenation, with no pending observations
    postStateConc{
        \schemaVar \formula phi;
        \schemaVar \formula #observation;
        \schemaVar \formula #stateFml;
        \schemaVar \update u;
        \schemaVar \term int i;
        \find(==> {u}\<{}\>(phi $. `#stateFml`))
        \varcond(\postStateCondition(phi,#stateFml),\not\containsObservations(phi))
        \replacewith(==>#stateFml);
        \replacewith(==> {u}\<{}\>(phi $. `true`))
        \heuristics(simplify)
    };

    distAndOverChopForSchemTr{
        \schemaVar \formula phi, phi1, phi2;
        \schemaVar \formula #observation;
        \schemaVar \formula #stateFml;
        \schemaVar \update u;
        \schemaVar \term int i;
        \find(phi & (phi1 ** phi2))
        \varcond(\isSchematicTrace(phi))
        \replacewith((phi & phi1) ** (phi & phi2))
//        \heuristics(concrete)
    };

    // eliminate trivial post state formula concatenated to trivial schematic trace: no equivalence, ~~.`true`
    // should have higher priority than rule:schematicTraceConcTrue
    trivialConc{
        \find(~~ $. `true`)
        \replacewith(~~)
        \heuristics(simplify_expression)
    };

    trivialChop{
        \find(~~ ** ~~)
        \replacewith(~~)
        \heuristics(simplify_expression)
    };

    reduceChopOfSchemTr{
        \schemaVar \formula phi;
        \find(phi ** phi)
        \varcond(\isSchematicTrace(phi))
        \replacewith(phi)
        \heuristics(simplify_expression)
    };

//    applyLocalRules{
//        \schemaVar \formula phi;
//        \schemaVar \update u;
//
//        \find(==> {u}\<{}\>(phi))
//            \addrules(
//
//                // eliminate trivial state formula after chop, no concerns about where observations are
//                chopTrueR{
//                    \schemaVar \formula phi1;
//                    \find(phi1 ** `true`)
//                    \varcond(\not\containsObservations(phi1))
//                    \replacewith(phi1)
//                    \heuristics(simplify)
//                },
//                // eliminate trivial state formula after chop
//
//                // eliminate trivial state formula before chop, no concerns about where observations are
//                chopTrueL{
//                    \schemaVar \formula phi1;
//                    \find(`true` ** phi1)
//                    \varcond(\not\containsObservations(phi1))
//                    \replacewith(phi1)
//                    \heuristics(simplify)
//                }
//
//                )
//        \heuristics(simplify)
//    };


    chopTrueR{
        \schemaVar \formula phi1;
        \find(phi1 ** `true`)
        \varcond(\not\containsObservations(phi1))
        \replacewith(phi1)
        \heuristics(simplify)
    };
    // eliminate trivial state formula after chop

    // eliminate trivial state formula before chop, no concerns about where observations are
    chopTrueL{
        \schemaVar \formula phi1;
        \find(`true` ** phi1)
        \varcond(\not\containsObservations(phi1))
        \replacewith(phi1)
        \heuristics(simplify)
    };

        removeTrivialObservationFirstEl{
            \schemaVar \formula phi,obs;
            \schemaVar \update u;
            \find({u}\<{}\>  (phi))
            \varcond(\noVarsInStates(\postfixTrace(phi)), \isObservation(\firstOf(phi)))
            \replacewith({u}\<{}\> #postfixTrace(phi))
            \heuristics(simplify)
        };

    // eliminate trivial trace formula in conjunction
    trivialAndL{
        \schemaVar \formula phi;
        \find(~~ & phi)
        \replacewith(phi)
        \heuristics(simplify)
    };

    // eliminate trivial trace formula in conjunction
    trivialAndR{
        \schemaVar \formula phi;
        \find(phi & ~~)
        \replacewith(phi)
        \heuristics(simplify)
    };

    expandTrivialTrace{
        \find(~~)
        \replacewith(~~ ** ~~)
    };



    elimPrefixWithSchemTrChop{
        \schemaVar \formula trace, tracePrefix, tracePostfix, tracePostfixCopy, schemTr;
        \schemaVar \update update, updatePrefix, updatePostfix;
        \assumes({updatePrefix}\<{}\>(tracePrefix) ==>)
        \find(==> {update}\<{}\>(trace))
        \varcond(
            \isAtomicTraceElem(\lastOf(tracePrefix)),
            \isSchematicTrace(\lastOf(tracePrefix))
            ,
            \prefixPostfixCondition(update,updatePrefix,updatePostfix)
            ,
            \prefixPostfixCondition(trace,tracePrefix,tracePostfix)
            ,
            \sameTrace(trace,tracePrefix ** tracePostfix)
            ,
            \not\containsObservations(tracePostfix)
            )
        \replacewith(==> {updatePostfix}\<{}\>(tracePostfix),{updatePostfix}\<{}\>(#lastOf(tracePrefix) ** tracePostfix))
        \heuristics(elimPrefix)
    };


    elimPrefixWithSchemTrConc{
        \schemaVar \formula trace, tracePrefix, tracePostfix;
        \schemaVar \update update, updatePrefix, updatePostfix;
        \assumes({updatePrefix}\<{}\>(tracePrefix) ==>)
        \find(==> {update}\<{}\>(trace))
        \varcond(
            \isAtomicTraceElem(\lastOf(tracePrefix)),
            \isSchematicTrace(\lastOf(tracePrefix))
            ,
            \prefixPostfixCondition(update,updatePrefix,updatePostfix)
            ,
            \prefixPostfixCondition(trace,tracePrefix,tracePostfix),
            \sameTrace(trace,tracePrefix $. tracePostfix)
            ,
            \not\containsObservations(tracePostfix)
            )
        \replacewith(==> {updatePostfix}\<{}\>(tracePostfix),{updatePostfix}\<{}\>(#lastOf(tracePrefix) $. tracePostfix))
        \heuristics(elimPrefix)
    };


    elimPrefixNoSchemTr{
        \schemaVar \formula trace, tracePrefix, tracePostfix;
        \schemaVar \update update, updatePrefix, updatePostfix;
        \assumes({updatePrefix}\<{}\>(tracePrefix) ==>) // assume che ci sia  u1 : t1 |- ...
        \find(==> {update}\<{}\>(trace)) // cerca   ... |- u : t
        \varcond(
            \isAtomicTraceElem(\lastOf(tracePrefix)), // puoi ignorare questo controlla che l'ultimo elemento di t1 sia atomico (o uno stato o un evento) (per wellformedness)
            \not\isSchematicTrace(\lastOf(tracePrefix))
            ,
            \prefixPostfixCondition(update,updatePrefix,updatePostfix)
            ,
            \prefixPostfixCondition(trace,tracePrefix,tracePostfix)
            ,
            \not\containsObservations(tracePostfix)
            )
        \replacewith(==> {updatePostfix}\<{}\>(tracePostfix))
        \heuristics(elimPrefix)
    };

    elimRunMatchPopWithLeadingUpdateLeadingTrace {
        \schemaVar \program MethodName methodName;
        \schemaVar \term int i;
        \schemaVar \term boolean sync;
        \schemaVar \formula prefix,schemTr;
        \schemaVar \update update;
        \find(==> {update;\runEv(methodName,i,sync)}\<{}\>(prefix ** schemTr ** \popTrEv(methodName,$?)))
        \varcond(\not\isSchematicTraceOverM(schemTr, methodName))
        \add(==> {update}\<{}\>(prefix))
        \heuristics(simplify)
    };

    elimRunMatchPopWithLeadingUpdateNoLeadingTrace {
        \schemaVar \program MethodName methodName;
        \schemaVar \term int i;
        \schemaVar \term boolean sync;
        \schemaVar \formula schemTr;
        \schemaVar \update update;
        \find(==> {update;\runEv(methodName,i,sync)}\<{}\>(schemTr ** \popTrEv(methodName,$?)))
        \varcond(\not\isSchematicTraceOverM(schemTr, methodName))
        \add(==> {update}\<{}\>(schemTr))
        \heuristics(simplify)
    };

    elimRunMatchPopNoLeadingUpdateNoLeadingTrace {
        \schemaVar \program MethodName methodName;
        \schemaVar \term int i;
        \schemaVar \term boolean sync;
        \schemaVar \formula schemTr;
        \schemaVar \update update;
        \find(==> {update;\runEv(methodName,i,sync)}\<{}\>(schemTr ** \popTrEv(methodName,$?)))
        \varcond(\not\isSchematicTraceOverM(schemTr, methodName))
        \add(==> {update}\<{}\>(schemTr))
        \heuristics(simplify)
    };

    // elimination of trivial state formula after concatenation with general schematic trace

    matchSchemTr{
        \schemaVar \formula schemTr;
        \schemaVar \update u,ev;
        \find(==> {u;ev}\<{}\>(schemTr))
        \varcond(\isEvent(ev),
                \isSchematicTrace(schemTr),
                \isEventWithMethod(ev),
                \not\isSchematicTraceOverM(schemTr,\methodNameOf(ev)))
        \replacewith(==> {u}\<{}\>(schemTr))
        \heuristics(simplify)
    };


    schematicTraceConcTrue{
        \schemaVar \formula phi;
        \schemaVar \update u;
        \find(==> {u}\<{}\>(phi $. `true`))
        \varcond(\isSchematicTrace(phi))
        \replacewith(==> {u}\<{}\>(phi))
        \heuristics(simplify_expression)
    };

    or{
        \schemaVar \formula phi,phi1;
        \schemaVar \update u;
        \find(==> {u}\<{}\>(phi | phi1))
        \replacewith(==> {u}\<{}\>(phi), {u}\<{}\>(phi1))
        \heuristics(simplify)
    };

    and{
        \schemaVar \formula phi,phi1;
        \schemaVar \update u;
        \find(==> {u}\<{}\>(phi & phi1))
        \replacewith(==> {u}\<{}\>(phi));
        \replacewith(==> {u}\<{}\>(phi1))
        \heuristics(simplify)
    };

    andFormulaNestedInChop{
        \schemaVar \formula phi,phi1,phi2;
        \schemaVar \update u;
        \find(==> {u}\<{}\>(phi ** (phi1 & phi2)))
        \replacewith(==> {u}\<{}\>(phi ** phi1));
        \replacewith(==> {u}\<{}\>(phi ** phi2))
//        \heuristics(simplify)
    };

    andFormulaNestedInConcat{
        \schemaVar \formula phi,phi1,phi2;
        \schemaVar \update u;
        \find(==> {u}\<{}\>(phi $. (phi1 & phi2)))
        \replacewith(==> {u}\<{}\>(phi $. phi1));
        \replacewith(==> {u}\<{}\>(phi $. phi2))
//        \heuristics(simplify)
    };


    closeForSchematicTraceIncluded {

        \schemaVar \formula trAnte, trSucc;
        \schemaVar \update update;
        \assumes({update}\<{}\>(trAnte)==>)
        \find(==> {update}\<{}\>(trSucc))
        \varcond(\isSchematicTraceIncluded(trSucc,trAnte))
        \closegoal
        \heuristics(closure)
    };

    closeForSchematicTraceIncludedWithTrailStateFml {
            \schemaVar \formula trAnte, trSucc, #stateFml;
            \schemaVar \update update;
            \assumes({update}\<{}\>(trAnte ** `#stateFml`)==>)
            \find(==> {update}\<{}\>(trSucc))
            \varcond(\isSchematicTraceIncluded(trSucc,trAnte))
            \closegoal
            \heuristics(closure)
        };

    //possibly useful
//    closeForSameJudgmentWithTrailStateFml {
//            \schemaVar \formula trAnte, #stateFml;
//            \schemaVar \update update;
//            \assumes({update}\<{}\>(trAnte ** `#stateFml`)==>)
//            \find(==> {update}\<{}\>(trAnte))
//            \varcond()
//            \closegoal
//            \heuristics(closure)
//        };

    andChopR{
        \schemaVar \formula phi,phi1, phi2;
        \schemaVar \update u;
        \find(==> {u}\<{}\>(phi **  (phi1 & phi2)))
        \replacewith(==> {u}\<{}\>(phi ** phi1));
        \replacewith(==> {u}\<{}\>(phi ** phi2))
        \heuristics(simplify)
    };
    andChopL{
        \schemaVar \formula phi,phi1, phi2;
        \schemaVar \update u;
        \find(==> {u}\<{}\>((phi & phi1) ** phi2))
        \replacewith(==> {u}\<{}\>(phi ** phi2));
        \replacewith(==> {u}\<{}\>(phi1 ** phi2))
        \heuristics(simplify)
    };

    matchLonelyStartEvWithSchemTr{
        \schemaVar \formula phi;
        \schemaVar \program MethodName methodName;
        \schemaVar \update u;
        \find(==> {\startEv(methodName,0)}\<{}\>(phi))
        \varcond(\isSchematicTrace(phi), \not\isSchematicTraceOverM(phi, methodName))
        \closegoal
        \heuristics(closure)
    };

    splitSameLeadHavocUpdateWithLeadTraceEvent{
        \schemaVar \formula phiAnte, phiCons;
        \schemaVar \term int i;
        \schemaVar \skolemTerm int id1, id2;
        \assumes({\havoc(i)}\<{}\>(phiAnte)==>)
        \find(==> {\havoc(i)}\<{}\>(phiCons))
        \varcond(
            \isEvent(\firstOf(phiAnte)),
            \isEvent(\firstOf(phiCons)),
            \hasPostfix(phiAnte),
            \hasPostfix(phiCons))
        "split havoc 1":
        \replacewith(==> {\havoc(1)}\<{}\>(#firstOf(phiCons)))
        \add({\havoc(1)}\<{}\>(#firstOf(phiAnte))==>);
        "split havoc 2":
        \replacewith(==> {\havoc(2)}\<{}\>(#postfixTrace(phiCons)))
        \add({\havoc(2)}\<{}\>(#postfixTrace(phiAnte))==>)
        \heuristics(simplify)
    };

    havocWithMatchingSingleStartEv{
        \schemaVar \formula phiAnte, phiCons;
        \schemaVar \term int i,callId;
        \schemaVar \program MethodName methodName;
        \assumes({\havoc(i)}\<{}\>(\startTrEv(methodName,callId))==>)
        \find(==>{\havoc(i)}\<{}\>(\startTrEv(methodName,$?)))
        \closegoal
        \heuristics(closure)
    };

    elimSchemTrNonMatchingWithEv{
        \schemaVar \formula phiAnte, phiCons;
        \schemaVar \program MethodName methodName;
        \schemaVar \update u;
        \assumes({u}\<{}\>(phiAnte)==>)
        \find(==> {u}\<{}\>(phiCons))
        \varcond(
            \isEvent(\firstOf(phiAnte)),
            \isSchematicTrace(\firstOf(phiCons)),
            \isSchematicTraceOverM(\firstOf(phiCons), \methodNameOf(\firstOf(phiAnte))))
        \replacewith(==> {u}\<{}\>(#postfixTrace(phiCons)))
        \heuristics(simplify)
    };

    elimStartEvSchemTr{
        \schemaVar \formula phi;
        \schemaVar \program MethodName methodName;
        \schemaVar \update u;
        \schemaVar \term int i;
        \find(==> {u;\startEv(methodName,i)}\<{}\>(phi))
        \varcond(\isSchematicTrace(phi), \not\isSchematicTraceOverM(phi, methodName))
        \replacewith(==> {u}\<{}\>(phi))
        \displayname "Elim StartEv SchemTr"
        \heuristics(closure)
    };

    elimSchemTrWithSingleEvent{
        \schemaVar \formula phi, schemTr;
        \schemaVar \update u;
        \find(==> {u}\<{}\>(phi ** schemTr))
        \varcond(\isEvent(u), \isEvent(phi), \isSchematicTrace(schemTr))
        \replacewith(==> {u}\<{}\>(phi))
        \displayname "elimSchemTrToMatchSingleEvents"
        \heuristics(simplify)
    };

    elimPopEvSchemTr{
        \schemaVar \formula phi;
        \schemaVar \program MethodName methodName;
        \schemaVar \update u;
        \schemaVar \term int i;
        \find(==> {u;\popEv(methodName,i)}\<{}\>(phi))
        \varcond(\isSchematicTrace(phi), \not\isSchematicTraceOverM(phi, methodName))
        \replacewith(==> {u}\<{}\>(phi))
        \heuristics(simplify)
    };
    elimRunEvSchemTr{
        \schemaVar \formula phi;
        \schemaVar \program MethodName methodName;
        \schemaVar \update u;
        \schemaVar \term int i;
        \schemaVar \term boolean sync;
        \find(==> {u;\runEv(methodName,i,sync)}\<{}\>(phi))
        \varcond(\isSchematicTrace(phi), \not\isSchematicTraceOverM(phi, methodName))
        \replacewith(==> {u}\<{}\>(phi))
        \heuristics(simplify)
    };

    // extend this rule same --> create preFix generator
    elimRunEvSchemTrPopEv{
        \schemaVar \formula phi,schemTr;
        \schemaVar \program MethodName methodName;
        \schemaVar \update u;
        \schemaVar \term int i;
        \schemaVar \term boolean sync;
        \find(==> {u;\runEv(methodName,i,sync)}\<{}\>(schemTr ** \popTrEv(methodName,$?)))
        \varcond(\isSchematicTrace(schemTr),\not\isSchematicTraceOverM(schemTr, methodName))
        \replacewith(==> {u}\<{}\>(schemTr))
//        \heuristics(simplify)
    };

    elimRunEvSchemTrPopEvComplexTrace{
        \schemaVar \formula phi,schemTr;
        \schemaVar \program MethodName methodName;
        \schemaVar \update u;
        \schemaVar \term int i;
        \schemaVar \term boolean sync;
        \find(==> {u;\runEv(methodName,i,sync)}\<{}\>(phi ** schemTr ** \popTrEv(methodName,$?)))
        \varcond(\isSchematicTrace(schemTr),\not\isSchematicTraceOverM(schemTr, methodName))
        \replacewith(==> {u}\<{}\>(phi),{u}\<{}\>(phi ** schemTr))
//        \heuristics(simplify)
    };

    elimRetEvSchemTr{
        \schemaVar \formula phi;
        \schemaVar \update u;
        \schemaVar \term int i;
        \find(==> {u;\retEv(i)}\<{}\>(phi))
        \varcond(\isSchematicTrace(phi))
        \replacewith(==> {u}\<{}\>(phi))
        \heuristics(simplify)
    };

    closeForSingleRetEvSchemTr{
        \schemaVar \formula phi;
        \schemaVar \update u;
        \schemaVar \term int i;
        \find(==> {\retEv(i)}\<{}\>(phi))
        \varcond(\isSchematicTrace(phi))
        \closegoal
        \heuristics(closure)
    };



    elimAssignEvSchemTrLeadingUpdate{
        \schemaVar \formula phi;
        \schemaVar \update u;
        \find(==> {u;#loc := #se}\<{}\>(phi))
        \varcond(\isSchematicTrace(phi))
        \replacewith(==> {u}\<{}\>(phi))
        \heuristics(simplify)
    };

    elimAssignEvSchemTr{
        \schemaVar \formula phi;
        \schemaVar \update u;
        \find(==> {#loc := #se}\<{}\>(phi))
        \varcond(\isSchematicTrace(phi))
        \closegoal
        \heuristics(simplify)
    };


    elimMatchingPopEv{
        \schemaVar \formula phi,phi1;
        \schemaVar \term MethodName #mn;
        \schemaVar \update u;
        \schemaVar \term int #i;
        \find(==> {u;\popEv(#mn,#i)}\<{}\>(phi **\popTrEv(#mn,#i)))
        \replacewith(==> {u}\<{}\>(phi))
        \heuristics(simplify)
    };


}

\rules(programRules:CAT){
    //SYMBOLIC_EXECUTION
    bindCallIdForAssumptions{
        \schemaVar \variable Z y;
        \schemaVar \formula phi;
        \schemaVar \program MethodName #mn;
        \find(assumeCATof(#mn, callId{y;}(phi)))
        \replacewith(assumeCATof(#mn, bind{y;}(phi)))
        \heuristics(concrete)
    };

    //SYMBOLIC_EXECUTION
    bindCallId{
        \schemaVar \variable Z y;
        \schemaVar \formula phi;
        \schemaVar \program MethodName #mn;

        \schemaVar \skolemTerm Z callIdSk;
        \find(==> CATof(#mn, callId{y;}(phi)))
        \varcond(\newDependingOn(callIdSk, phi))
        \replacewith(==>CATof(#mn,{\subst y; callIdSk}phi))
        \add(callIdSk = 0 ==>)
        \heuristics(concrete)
    };

    //SYMBOLIC_EXECUTION
    bindContractSuccedent{
        \schemaVar \variable Z y;
        \schemaVar \formula phi;
        \schemaVar \program MethodName #mn;
        \find(CATof(#mn, bind{y;}(phi)))
        \varcond(\newDependingOn(observingSk, phi))
        \replacewith(CATof(#mn,{\subst y; observingSk}phi))
        \heuristics(concrete)
    };

//    compound_assignment_op_plus {
//        \find(\modality{#globalJudge}{.. #lhs += #e; ...}\endmodality (post))
//        \replacewith(\modality{#globalJudge}{.. #lhs = (#typeof(#lhs))(#lhs + (#e)); ...}\endmodality (post))
//        \heuristics(simplify_prog)
//    };


}

\rules(programRules:CAT){
    // SYMBOLIC EXECUTION

    //SYMBOLIC_EXECUTION
    applyContract{

        \schemaVar \formula pre_trace, inner_trace,post_trace,stateFml;
        \schemaVar \update u;
        \schemaVar \program MethodName #mn;
        \schemaVar \term MethodName methodName;
        \find(==> \[{.. #t.#mn(true); ...}\]applyContract(u, CATof(methodName,CAT(pre_trace**`stateFml`,inner_trace,post_trace))))
        \varcond(\methodNameConstant(#t, #mn, methodName))
        \replacewith(==>{u;\startEv(methodName,0)} \[{#method-call(#t.#mn(true));}\](pre_trace **`stateFml` **  inner_trace))
        \add(
            {\startEv(methodName,0)}\<{}\>(\startTrEv(methodName,0)),
            stateFml,
             {u;\startEv(methodName,0)}\<{}\>(pre_trace**`stateFml`**\startTrEv(methodName,0)),
             {u}\<{}\>(pre_trace**`stateFml`)

            ==>)
        \heuristics(concrete)
    };

    //SYMBOLIC_EXECUTION
    startObservingForContract{
        \schemaVar \formula #observation;
        \schemaVar \formula stateFml;
        \schemaVar \formula pre_trace, inner_trace,post_trace;
        \schemaVar \term Z observed, observing;
        \schemaVar \program MethodName #mn;
        \schemaVar \term MethodName methodName;
        \schemaVar \skolemTerm int anonId;
        \find(==> \[{.. #t.#mn(true); ...}\]CATof(methodName,CAT(pre_trace,inner_trace,post_trace)))
        \varcond(\methodNameConstant(#t, #mn, methodName))
        \replacewith(==> \[{.. #t.#mn(true); ...}\]observeForContract(\havoc(anonId),CATof(methodName,CAT(pre_trace,inner_trace,post_trace))))
        \heuristics(concrete)
    };

    //SYMBOLIC_EXECUTION
    observeForContractInPreTrace{
        \schemaVar \formula #obs;
        \schemaVar \formula stateFml;
        \schemaVar \formula pre_trace, inner_trace,post_trace;
        \schemaVar \term Z observed, observing;
        \schemaVar \program MethodName #mn;
        \schemaVar \term MethodName methodName;
        \schemaVar \update u;
        \find(observeForContract(u, CATof(methodName, CAT((pre_trace $. #obs) $. `stateFml`,inner_trace,post_trace))))
        \varcond(
            \observationCondition(#obs, observed, observing)
            )
        \replacewith(observeForContract(u, CATof(methodName, CAT(pre_trace $.  `stateFml`,inner_trace,post_trace))))
        \add(({u} observed) = observing ==>)
        \heuristics(concrete)
    };

    //SYMBOLIC_EXECUTION
    observeForContractApplicationInPreTrace{
        \schemaVar \formula #obs;
        \schemaVar \formula stateFml,phi;
        \schemaVar \formula pre_trace, inner_trace,post_trace;
        \schemaVar \term Z observed, observing;
        \schemaVar \program MethodName #mn;
        \schemaVar \term MethodName methodName;
        \schemaVar \update u;
        \find(
        ==> observeForContractApplication(CATof(methodName, CAT((pre_trace $. #obs) $. `stateFml`,inner_trace,post_trace)), {u}phi)
        )
        \varcond(
            \observationCondition(#obs, observed, observing)
            )
        \replacewith(
            ==> observeForContractApplication(CATof(methodName, CAT(pre_trace $. `stateFml`,inner_trace,post_trace)), {u}phi))

        \add(({u} observed) = observing ==>)
        \heuristics(concrete)
    };

    //SYMBOLIC_EXECUTION
    lastObservationInPreTraceForContract{
        \schemaVar \formula #obs;
        \schemaVar \formula stateFml;
        \schemaVar \formula pre_trace, inner_trace,post_trace;
        \schemaVar \term Z observed, observing;
        \schemaVar \program MethodName #mn;
        \schemaVar \term MethodName methodName;
        \schemaVar \update u;
        \find(observeForContract(u, CATof(methodName, CAT((pre_trace ** #obs) $. `stateFml`,inner_trace,post_trace))))
        \varcond(
            \observationCondition(#obs, observed, observing)
            )
        \replacewith(applyContract(u, CATof(methodName, CAT(pre_trace **  `stateFml`,inner_trace,post_trace))))
        \add(({u} observed) = observing ==>)
        \heuristics(concrete)
    };

    //SYMBOLIC_EXECUTION
    noObservationInPreTraceForContract{
        \schemaVar \formula #obs;
        \schemaVar \formula stateFml;
        \schemaVar \formula pre_trace, inner_trace,post_trace;
        \schemaVar \term Z observed, observing;
        \schemaVar \program MethodName #mn;
        \schemaVar \term MethodName methodName;
        \schemaVar \update u;
        \find(observeForContract(u, CATof(methodName, CAT(pre_trace,inner_trace,post_trace))))
        \varcond(
            \not\containsObservations(pre_trace)
            )
        \replacewith(applyContract(u, CATof(methodName, CAT(pre_trace,inner_trace,post_trace))))
        \heuristics(concrete)
    };

    //SYMBOLIC_EXECUTION
    variableDeclarationAssign {
        \schemaVar \program VariableInitializer #vi;
        \find(\modality{#globalJudge}{.. #t #v0 = #vi; ...}\endmodality (post))
        \replacewith(\modality{#globalJudge}{.. #t #v0; #v0 = #vi; ...}\endmodality (post))
        \heuristics(simplify_prog, simplify_prog_subset)
        \displayname "variableDeclaration"
    };
    //SYMBOLIC_EXECUTION
    methodBodyExpand {
        \schemaVar \program NonModelMethodBody #mb;
        \schemaVar \skolemTerm int anonId;
        \schemaVar \update u;
        \schemaVar \program Variable sync;
        \find({u;sync:=TRUE}\modality{#globalJudge}{.. #mb ...}\endmodality (post))
        \replacewith({u}\modality{#globalJudge}{.. #expand-method-body(#mb); ...}\endmodality (post))
        \heuristics(concrete)
    };

    //SYMBOLIC_EXECUTION
    contract{
        \schemaVar \formula pre_trace, inner_trace,post_trace;
        \schemaVar \program MethodName #mn;
        \schemaVar \term MethodName methodName;
        \schemaVar \skolemTerm int anonId;
        \find(==> CATof(methodName, CAT(pre_trace,inner_trace,post_trace)))
        \varcond(\methodNameConstant(#t, #mn, methodName))
        \replacewith(==>\[{#t.#mn(true);}\]CATof(methodName,CAT(pre_trace,inner_trace,post_trace)))
        \heuristics(concrete)
    };

    //SYMBOLIC_EXECUTION
    lastObservationInPreTraceForContractApplication{
        \schemaVar \formula #obs;
        \schemaVar \formula stateFml, phi;
        \schemaVar \formula pre_trace, inner_trace,post_trace;
        \schemaVar \term Z observed, observing;
        \schemaVar \program MethodName #mn;
        \schemaVar \term MethodName methodName;
        \schemaVar \update u;
        \find(==> observeForContractApplication(CATof(methodName, CAT((pre_trace ** #obs) $. `stateFml`,inner_trace,post_trace)), {u}phi))
        \varcond(
            \observationCondition(#obs, observed, observing)
            )
        \replacewith(
            ==> readyForContractApplication(CATof(methodName, CAT(pre_trace ** `stateFml`,inner_trace,post_trace)), {u}phi))

        \add(({u} observed) = observing ==>)
        \heuristics(simplify_prog)
    };

    //SYMBOLIC_EXECUTION
    return{
        \find(\[{.. return;...}\](post))
        \replacewith({\retEv(0)}\[{}\](post))
        \heuristics(simplify_prog, simplify_prog_subset)
        \displayname "return"
    };

    //SYMBOLIC_EXECUTION
    scheduleTmp {
        \schemaVar \update #u;
        \schemaVar \program MethodName methodName;
        \schemaVar \skolemTerm int callId;
        \find({#u}\modality{#globalJudge}{}\endmodality(post))
        \varcond(\pendingInvocationCondition(#u, methodName, callId))
        \replacewith({#u;\runEv(methodName,callId,FALSE)}\modality{#globalJudge}{}\endmodality(post))
        \displayname "scheduleTmp"
        \heuristics(simplify_prog, simplify_prog_subset)
    };

    //SYMBOLIC_EXECUTION
    finish {
        \schemaVar \update #u;
        \schemaVar \program MethodName methodName;
        \schemaVar \skolemTerm int callId;
        \find(==> {#u}\[{}\](post))
        \varcond(\finishCondition(#u,methodName))
        \replacewith(==> {#u;\popEv(methodName,0)}\<{}\>(post))
        \displayname "finish"
        \heuristics(simplify_prog)
    };

    //SYMBOLIC_EXECUTION
    invoc {
        \schemaVar \term MethodName methodName;
        \schemaVar \skolemTerm int callId;
        \schemaVar \program MethodName #mn;  // wrong sort in general, need better one
        \find(\modality{#globalJudge}{.. #t.#mn(false); ...}\endmodality(post))
        \varcond(\methodNameConstant(#t, #mn, methodName))
        \replacewith({\invocEv(methodName,callId)}\modality{#globalJudge}{.. ...}\endmodality(post))
        \heuristics(simplify_prog, simplify_prog_subset)
    };

    //SYMBOLIC_EXECUTION
    emptyStatement {
        \find(\modality{#globalJudge}{.. ; ...}\endmodality (post))
        \replacewith(\modality{#globalJudge}{..  ...}\endmodality (post))
        \heuristics(simplify_prog, simplify_prog_subset)
    };

    //SYMBOLIC_EXECUTION
    pre_Call {
        \schemaVar \term MethodName methodName;
        \schemaVar \formula phi, contract;
        \schemaVar \program MethodName #mn;  // wrong sort in general, need better one
        \schemaVar \update u;

        \assumes(assumeCATof(methodName, contract) ==>)
        \find(==> {u}\[{.. #t.#mn(true); ...}\](phi))

        \varcond(\methodNameConstant(#t, #mn, methodName))

        \replacewith(==> contractApplication(holdBindingCATof(methodName, contract),{u}\[{.. #t.#mn(true); ...}\](phi)))

        \heuristics(simplify_prog, simplify_prog_subset)
    };

    //SYMBOLIC_EXECUTION
    startObservingForCall{
        \schemaVar \term MethodName methodName;
        \schemaVar \formula cat,stateFml, #observation;
        \schemaVar \formula fullFormula, preFormula, innerFormula, postFormula;
        \schemaVar \formula preTraceP, innerTrace, postTrace;
        \schemaVar \program MethodName #mn;  // wrong sort in general, need better one
        \schemaVar \update u;
        \find(==> contractApplication(
            holdBindingCATof(methodName, cat), {u}\[{.. #t.#mn(true); ...}\](fullFormula)))
        \varcond(\methodNameConstant(#t, #mn, methodName))
        \replacewith(==> observeForContractApplication(CATof(methodName, cat), {u}\[{.. #t.#mn(true); ...}\](fullFormula)))
        \heuristics(simplify_prog)
    };

    //SYMBOLIC_EXECUTION
    newCallWithAdd {
        \schemaVar \term MethodName methodName;
        \schemaVar \formula cat,stateFml, #observation;
        \schemaVar \formula fullFormula, preFormula, innerFormula, postFormula;
        \schemaVar \formula preTrace, innerTrace, postTrace;
        \schemaVar \skolemTerm int callId;
        \schemaVar \program MethodName #mn;  // wrong sort in general, need better one
        \schemaVar \update u;
        \schemaVar \skolemTerm int anonId;
        \find(==> readyForContractApplication(CATof(methodName, CAT(preTrace,innerTrace,postTrace)), {u}\[{.. #t.#mn(true); ...}\](fullFormula)))

        \varcond(\methodNameConstant(#t, #mn, methodName))

        "Pre-trace":
        \replacewith(==> {u} \<{}\>(preTrace & preFormula));

        "Inner behavior implication":
        \add({\havoc(anonId)}\<{}\> innerTrace ==> {\havoc(anonId)} \<{}\> innerFormula);

        "Continue":

        \add(
            {u; \runEv(methodName,callId,TRUE)}\<{}\>((preTrace & preFormula) ** innerTrace)
            ==>
            {u; \runEv(methodName,callId,TRUE)} \[{.. ...}\](
                        (preTrace & preFormula) ** innerTrace ** (postTrace & postFormula)
                        ))
//        \heuristics(traceCall)
    };


    newCallWithAddSplitting {
        \schemaVar \term MethodName methodName;
        \schemaVar \formula cat,stateFml, #observation;
        \schemaVar \formula fullFormula, preFormula, innerFormula, postFormula;
        \schemaVar \formula preTrace, innerTrace, postTrace;
        \schemaVar \skolemTerm int callId;
        \schemaVar \program MethodName #mn;  // wrong sort in general, need better one
        \schemaVar \update u;
        \schemaVar \skolemTerm int anonId;
        \find(==> readyForContractApplication(CATof(methodName, CAT(preTrace,innerTrace,postTrace)), {u}\[{.. #t.#mn(true); ...}\](fullFormula)))

        \varcond(\methodNameConstant(#t, #mn, methodName))

        "Pre-trace":
        \add(==> {u} \<{}\>(preTrace & preFormula));

        "Inner behavior implication":
        \add({\havoc(anonId)}\<{}\> innerTrace ==> {\havoc(anonId)} \<{}\> innerFormula);

        "Continue postTrace":

        \add(
            {u; \runEv(methodName,callId,TRUE)}\<{}\>((preTrace & preFormula) ** innerTrace)
            ==>
            {u; \runEv(methodName,callId,TRUE)} \[{.. ...}\](
                        (preTrace & preFormula) ** innerTrace ** postTrace)
                        );

        "Continue postFormula":
        \add(
            {u; \runEv(methodName,callId,TRUE)}\<{}\>((preTrace & preFormula) ** innerTrace)
            ==>
            {u; \runEv(methodName,callId,TRUE)} \[{.. ...}\](
                        (preTrace & preFormula) ** innerTrace ** postFormula)
                        )
        \heuristics(traceCall)
    };


    // SYMBOLIC_EXECUTION
    // application: manual
    callManual {
        \schemaVar \term MethodName methodName;
        \schemaVar \formula #observation;
        \schemaVar \skolemTerm int callId;
        \schemaVar \formula pre_trace, inner_trace,post_trace;
        \schemaVar \formula fullFormula, preFormula, innerFormula, postFormula,phi;
        \schemaVar \formula stateFml,stateFml1;
        \schemaVar \term Z observed;
        \schemaVar \term Z observing;
        \schemaVar \program MethodName #mn;  // wrong sort in general, need better one
        \schemaVar \update u;
        \schemaVar \skolemTerm int anonId;
        \find(==> contractApplication(
            CATof(methodName, CAT((pre_trace** #observation) $. `stateFml`,inner_trace,post_trace)),
            {u}\[{.. #t.#mn(true); ...}\](preFormula ** innerFormula ** postFormula )))

        \varcond(\observationCondition(#observation, observed, observing),\methodNameConstant(#t, #mn, methodName))

        "Pre-trace":
        \replacewith(==>{u} \<{}\>((pre_trace $. `stateFml`) & preFormula))
        \add(({u}observed)=observing==>);

        "Inner behavior implication":
        \replacewith(==> {\havoc(anonId)} \<{}\> innerFormula)
        \add(({u}observed)=observing, {\havoc(anonId)}\<{}\> inner_trace ==>);

        "Continue":
        \replacewith(==> {u; \runEv(methodName,callId,TRUE)} \[{.. ...}\](
            ((pre_trace $. `stateFml`) & preFormula) ** inner_trace ** (post_trace & (postFormula))
            ))
        \add(({u}observed)=observing,{u; \runEv(methodName,callId,TRUE)}\<{}\>(((pre_trace $. `stateFml`) & preFormula) ** inner_trace) ==>)

    };

    // SYMBOLIC_EXECUTION
    assign {
        \find(\modality{#globalJudge}{.. #loc = #se; ...}\endmodality (post))
        \replacewith({#loc := #se}\modality{#globalJudge}{.. ...}\endmodality (post))
        \heuristics(simplify_prog, simplify_prog_subset)
        \displayname "assign"
    };
    // SYMBOLIC_EXECUTION
//    greater_than_comparison {
//
//        \schemaVar \update #u;
//        \find({#u}\modality{#globalJudge}{.. #lhs = #senf0 > #senf1; ...}\endmodality (post))
//
//        \replacewith(\if(gt({#u}(#senf0),{#u}(#senf1))) \then({#u}\modality{#globalJudge}{.. #lhs = true;  ...}\endmodality (post))
//                \else({#u}\modality{#globalJudge}{.. #lhs = false; ...}\endmodality (post)))
//        \heuristics(simplify_prog)
//        \displayname "greater than distinction"
//    };

    // SYMBOLIC_EXECUTION
    assignThis {
            \find(\modality{#globalJudge}{.. this.#loc = #se; ...}\endmodality (post))
            \replacewith({#loc := #se}\modality{#globalJudge}{.. ...}\endmodality (post))
            \heuristics(simplify_prog, simplify_prog_subset)
            \displayname "assign"
    };
    // SYMBOLIC_EXECUTION
    ifUnfold {
        \find(\modality{#globalJudge}{.. if(#nse) #s0 ...}\endmodality (post))
        \varcond(\new(#boolv, boolean))
        \replacewith(\modality{#globalJudge}{.. boolean #boolv; #boolv = #nse; if(#boolv) #s0 ...}\endmodality (post))
        \heuristics(simplify_prog)
        \displayname "ifElseUnfold"
    };
    // SYMBOLIC_EXECUTION
    ifElseUnfold {
        \find(\modality{#globalJudge}{.. if(#nse) #s0 else #s1 ...}\endmodality (post))
        \varcond(\new(#boolv, boolean))
        \replacewith(\modality{#globalJudge}{.. boolean #boolv; #boolv = #nse; if(#boolv) #s0 else{#s1}
                ...}\endmodality (post))
        \heuristics(simplify_autoname)
        \displayname "ifElseUnfold"
    };
    // SYMBOLIC_EXECUTION

    updOverBool {
        \schemaVar \update u;
        \schemaVar \formula fml;
        \find(updOverBool(u,fml))
        \replacewith({u}fml)
        \heuristics(concrete)
    };

    delUpd{
        \schemaVar \update u1, u2;
        \find({u1;u2}(post))
        \replacewith({u1}(post))
    };

    applyUpdateOnStateFml {
        \schemaVar \update u;
        \schemaVar \update evUpdate;
        \find({u;evUpdate}(post))
        \replacewith({u}(post))

    };

    applyOnRigidFormula {
        \schemaVar \update u;
        \schemaVar \formula phi, result;

        \find({u}phi)
        \varcond(\applyUpdateOnRigid(u, phi, result))

        \replacewith(result)

        \heuristics(update_apply)
    };

    cond {

        \schemaVar \update u;
        \find(==> {u}\[{..  if(#nse) #s0...}\](post))
        "true-case":
        \replacewith(==> {u}\[{..  #s0 ...}\](post))
        \add(updOverBool(u,#nse)==>);
        "false-case":
        \replacewith(==> updOverBool(u,#nse),{u}\[{.. ...}\](post))
//        \add({u}(#nse=true)==> )
//        "false-case":
//        \replacewith(==> {u}\[{.. ...}\](post))
//        \add({u}(! #nse) b =! #nse ==> )
         \heuristics(simplify)
//        \displayname "ifElse"
    };
    // SYMBOLIC_EXECUTION
    ifElse {
        \find(\modality{#globalJudge}{.. if(#se) #s0 else #s1 ...}\endmodality (post))
        \replacewith(\if(#se = TRUE) \then(\modality{#globalJudge}{.. #s0 ...}\endmodality (post))
                \else(\modality{#globalJudge}{.. #s1 ...}\endmodality (post)))
         \heuristics(split_if)
        \displayname "ifElse"
    };
    // SYMBOLIC_EXECUTION
    blockEmpty {
        \find(\modality{#globalJudge}{.. {} ...}\endmodality (post))
        \replacewith(\modality{#globalJudge}{..  ...}\endmodality (post))
        \heuristics(simplify_prog, simplify_prog_subset)
    };

//    ifElseSplit {
//        \find( ==> \modality{#globalJudge}{.. if(#se) #s0 else #s1 ...}\endmodality (post))
//        "if #se true":
//            \replacewith( ==> \modality{#globalJudge}{.. #s0 ...}\endmodality (post)) \add(#se = TRUE ==>);
//        "if #se false":
//            \replacewith( ==> \modality{#globalJudge}{.. #s1 ...}\endmodality (post)) \add(#se = FALSE ==>)
//        \heuristics(split_if)
//        \displayname "ifElseSplit"
//    };
//
//    ifSplit {
//        \find( ==> \modality{#globalJudge}{.. if(#se) #s0  ...}\endmodality (post))
//        "if #se true":
//            \replacewith( ==> \modality{#globalJudge}{.. #s0 ...}\endmodality (post)) \add(#se = TRUE ==>);
//        "if #se false":
//            \replacewith( ==> \modality{#globalJudge}{..  ...}\endmodality (post)) \add(#se = FALSE ==>)
//        \heuristics(split_if)
//        \displayname "ifElseSplit"
//    };
//
//    ifElseSplitLeft {
//        \find(\modality{#globalJudge}{.. if(#se) #s0 else #s1 ...}\endmodality (post) ==>)
//        \replacewith(\modality{#globalJudge}{.. #s0 ...}\endmodality (post) ==>) \add(#se = TRUE ==>);
//        \replacewith(\modality{#globalJudge}{.. #s1 ...}\endmodality (post) ==>) \add(#se = FALSE ==>) \heuristics(split_if)
//    };
//
//    ifSplitLeft {
//        \find(\modality{#globalJudge}{.. if(#se) #s0  ...}\endmodality (post) ==>)
//        \replacewith(\modality{#globalJudge}{.. #s0 ...}\endmodality (post) ==>) \add(#se = TRUE ==>);
//        \replacewith(\modality{#globalJudge}{..  ...}\endmodality (post) ==>) \add(#se = FALSE ==>) \heuristics(split_if)
//    };
    // SYMBOLIC_EXECUTION
    ifTrue {
        \assumes(#se = TRUE ==>)
        \find( ==> \modality{#globalJudge}{.. if (#se) #s0 ...}\endmodality (post))
        \replacewith( ==> \modality{#globalJudge}{.. #s0 ...}\endmodality (post))
        \heuristics(simplify_prog)
    };
    // SYMBOLIC_EXECUTION
    ifElseTrue {
        \assumes(#se = TRUE ==>)
        \find( ==> \modality{#globalJudge}{.. if (#se) #s0 else #s1 ...}\endmodality (post))
        \replacewith( ==> \modality{#globalJudge}{.. #s0 ...}\endmodality (post))
        \heuristics(simplify_prog)
    };
    // SYMBOLIC_EXECUTION
    ifFalse {
        \assumes(#se = FALSE ==>)
        \find( ==> \modality{#globalJudge}{.. if (#se) #s0 ...}\endmodality (post))
        \replacewith( ==> \modality{#globalJudge}{.. ...}\endmodality (post))
        \heuristics(simplify_prog)
    };
    // SYMBOLIC_EXECUTION
    ifElseFalse {
        \assumes(#se = FALSE ==>)
        \find( ==> \modality{#globalJudge}{.. if (#se) #s0 else #s1 ...}\endmodality (post))
        \replacewith( ==> \modality{#globalJudge}{.. #s1 ...}\endmodality (post))
        \heuristics(simplify_prog)
    };
    // SYMBOLIC_EXECUTION
    ifEnterThen {
        \find(\modality{#globalJudge}{.. #loc=true; if (#loc) #s0 ...}\endmodality (post))
        \replacewith(\modality{#globalJudge}{.. #loc=true; #s0 ...}\endmodality (post))
        \heuristics(simplify)
    };
    // SYMBOLIC_EXECUTION
    ifSkipThen {
        \find(\modality{#globalJudge}{.. #loc=false; if (#loc) #s0 ...}\endmodality (post))
        \replacewith(\modality{#globalJudge}{.. #loc=false; ...}\endmodality (post))
        \heuristics(simplify)
    };
    // SYMBOLIC_EXECUTION
    ifElseSkipElse {
        \find(\modality{#globalJudge}{.. #loc=true; if (#loc) #s0 else #s1 ...}\endmodality (post))
        \replacewith(\modality{#globalJudge}{.. #loc=true; #s0 ...}\endmodality (post))
        \heuristics(simplify)
    };
    // SYMBOLIC_EXECUTION
    ifElseSkipThen {
        \find(\modality{#globalJudge}{.. #loc=false; if (#loc) #s0 else #s1 ...}\endmodality (post))
        \replacewith(\modality{#globalJudge}{.. #loc=false; #s1 ...}\endmodality (post))
        \heuristics(simplify)
    };
    // SYMBOLIC_EXECUTION
    variableDeclaration {
        \find(\modality{#globalJudge}{.. #t #v0; ...}\endmodality (post))
        \replacewith(\modality{#globalJudge}{..  ...}\endmodality (post))
        \addprogvars(#v0)
        \heuristics(simplify_prog, simplify_prog_subset)
        \displayname "variableDeclaration"
    };
    // SYMBOLIC_EXECUTION
    equality_comparison_simple {
        \find(\modality{#globalJudge}{.. #lhs = #senf0 == #senf1; ...}\endmodality (post))
        \replacewith({#lhs := \if(#senf0 = #senf1) \then(TRUE) \else(FALSE)}
            \modality{#globalJudge}{.. ...}\endmodality (post))
        \heuristics(simplify_prog)
        \displayname "equality comparison"
    };

    // SYMBOLIC_EXECUTION
    eval_order_access4_this {
        \schemaVar \program StaticVariable #staticA;
        \find(\modality{#globalJudge}{.. #staticA=#nse; ...}\endmodality (post))
        \varcond(\newTypeOf(#v, #nse))
        \replacewith(\modality{#globalJudge}{..
                #typeof(#nse) #v=#nse;
                #staticA=#v;...}\endmodality (post))
        \heuristics(simplify_prog, simplify_prog_subset)
        \displayname "assignmentSaveLocationThis"
    };

}

\rules{
    // MANUAL TRACE MANIPULATOR

    // TRACE MANIPULATION
    // application: MANUAL
    assocChopAnd{
        \schemaVar \formula phi1, phi2, phi3;
        \find((phi1 & phi2) ** phi3)
        \replacewith((phi1 ** phi3) & (phi2** phi3))

    };

    // TRACE MANIPULATION
    // application: MANUAL
    assocConcAndR{
        \schemaVar \formula phi1, phi2, phi3;
        \find((phi1 & phi2) $. phi3)
        \replacewith((phi1 $. phi3) & (phi2 $. phi3))
    };

    // TRACE MANIPULATION
    // application: MANUAL
    assocConcAndL{
        \schemaVar \formula phi1, phi2, phi3;
        \find(phi1 $. (phi2 & phi3))
        \replacewith((phi1 $. phi2) & (phi1 $. phi3))
    };
}