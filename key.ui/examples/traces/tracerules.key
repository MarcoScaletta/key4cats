\sorts{
    \generic Z;
}

\schemaVariables{
    \modalOperator {diamond} #localJudge;
    \modalOperator {box} #globalJudge;
    \modalOperator {box, diamond} #anyJudge;
    \formula post;
    \program Variable #loc;
    \program SimpleExpression #se;
    \program Expression #e;
    \program Statement #s, #s0, #s1;
    \program NonSimpleExpression #nse;
    \program [list] Statement #slist, #slist0;
    \program Variable #boolv, #v0, #v, #a; // #v, #v0, #v1, #v2, #boolv, #a, #a0, #a1;
    \program Type #t, #t2;
    \program SimpleExpressionNonFloatDouble #senf, #senf0, #senf1;
    \program LeftHandSide #lhs, #lhs0, #lhs1, #lhs2;
    \program JavaBooleanExpression #exBool;

    \skolemTerm Z observingSk;



    \variable int oId;
}


\rules{

    elimPopEv{
        \schemaVar \update u, u2;
        \schemaVar \term int i;
        \schemaVar \program Variable pv;
        \schemaVar \term MethodName m;
        \find({u;\popEv(m,i)}pv)
        \replacewith({u}pv)
        \heuristics(update_elim)
    };

    elimRetEv{
        \schemaVar \update u, u2;
        \schemaVar \term int i;
        \schemaVar \program Variable pv;
        \find({u;\retEv(i)}pv)
        \replacewith({u}pv)
        \heuristics(update_elim)
    };

    elimStarEv{
        \schemaVar \update u, u2;
        \schemaVar \term int i;
        \schemaVar \program Variable pv;
        \schemaVar \term MethodName m;
        \find({u;\startEv(m,i)}pv)
        \replacewith({u}pv)
        \heuristics(update_elim)
    };

    applyUpdateOnSamePV{
        \schemaVar \update u, u2;
        \schemaVar \program Variable pv;
        \schemaVar \term Z t;
        \find({u;pv:=t}pv)
        \replacewith({u}t)
        \heuristics(update_apply)
    };

    applyUpdateOnDifferentPV{
        \schemaVar \update u, u2;
        \schemaVar \program Variable pv,pv1;
        \schemaVar \term Z t;
        \find({u;pv:=t}pv1)
        \varcond(\different(pv,pv1))
        \replacewith({u}pv1)
        \heuristics(update_apply)
    };

    applyOnRigidTermCAT {
        \schemaVar \update u;
        \schemaVar \term any t, result;

        \find({u}t)
        \varcond(\applyUpdateOnRigid(u, t, result))

        \replacewith(result)

        \heuristics(update_apply)
    };

    applyOnRigidConstant{

        \schemaVar \update u;
        \schemaVar \term [rigid] any t;

        \find({u}t)

        \replacewith(t)

        \heuristics(update_apply)
    };

}

\rules {

    nestedUpdateToSeqUpdate{
        \schemaVar \update u, u2;
        \schemaVar \formula phi;
        \find(
            {u}{u2}phi
        )
        \replacewith(
            {u;u2}phi
        )
        \heuristics(update_join)
    };

    trivialSchemTr {
        \schemaVar \update u;
        \find(==>{u}\<{}\>(~~))
        \closegoal
        \displayname "Trivial Schematic Trace"
        \heuristics(closure)
    };

    preAssociativityTraces1 {
        \schemaVar \formula phi,phi1,phi2,phi3;
        \find(phi ** (phi1 ** phi2))
        \replacewith((phi ** phi1) ** phi2)
        \heuristics(simplify)
        };

    preAssociativityTraces2 {
        \schemaVar \formula phi,phi1,phi2,phi3;
        \find(phi ** (phi1 $. phi2))
        \replacewith((phi ** phi1) $. phi2)
        \heuristics(simplify)
    };


    preAssociativityTraces3 {
        \schemaVar \formula phi,phi1,phi2,phi3;
        \find(phi $. (phi1 $. phi2))
        \replacewith((phi $. phi1) $. phi2)

//        \heuristics(simplify)
    };

    preAssociativityTraces4 {
        \schemaVar \formula phi,phi1,phi2,phi3;
        \find(phi $. (phi1 ** phi2))
        \replacewith((phi $. phi1) ** phi2)
    };

    postAssociativityTraces1 {
        \schemaVar \formula phi,phi1,phi2,phi3;
        \find((phi ** phi1) ** phi2)
        \replacewith(phi ** (phi1 ** phi2))
//        \heuristics(simplify)
    };

    postAssociativityTraces2 {
        \schemaVar \formula phi,phi1,phi2,phi3;
        \find((phi ** phi1) $. phi2)
        \replacewith(phi ** (phi1 $. phi2))
//        \heuristics(simplify)
    };

    obsR{
        \schemaVar \formula phi;
        \schemaVar \formula #observation;
        \schemaVar \formula stateFml;
        \schemaVar \update u;
        \schemaVar \term int i;
        \schemaVar \term Z observed, observing;
        \find(==>{u}\<{}\>((phi ** #observation) $. `stateFml`))
        \varcond(\observationCondition(#observation, observed, observing))
        \replacewith(==>{u}\<{}\>(phi ** `stateFml`))
        \add(({u}observed) = observing ==>)
        \heuristics(simplify)
    };

    make_obsL{
        \schemaVar \formula phi,phi1;
        \schemaVar \formula #observation;
        \schemaVar \formula stateFml;
        \schemaVar \update u,u1;
        \schemaVar \term int i;
        \schemaVar \term Z observed, observing;

        \find(==> {u1}\<{}\>(phi1))
                \varcond(\not\containsObservations(phi1))
        \addrules(
            obsL{
                \find({u}\<{}\>((phi ** #observation) $. `stateFml`)==>)
                \varcond(\observationCondition(#observation, observed, observing))
                \replacewith({u}\<{}\>(phi ** `stateFml`)==>)
                \add(({u}observed) = observing,stateFml ==>)
                \heuristics(concrete)
            })
        \heuristics(concrete)
    };


    interObsR{

        \schemaVar \formula tracePrefix, #tracePostfix, traceFull, #observation;
        \schemaVar \update updateFull,updatePrefix;
        \schemaVar \term Z #observed, #observing;
        \assumes({updatePrefix}\<{}\>(tracePrefix)==>)
        \find(==> {updateFull}\<{}\>(traceFull))
        \varcond(
            \interObs(updateFull, updatePrefix, traceFull, tracePrefix, #tracePostfix, #observed, #observing),
            \not\containsObservations(#tracePostfix))
        \replacewith(==> {updateFull}\<{}\>(tracePrefix ** #tracePostfix))
        \add(({updatePrefix}#observed) = #observing ==>)

        \heuristics(simplify)

    };

    postStateChop{
        \schemaVar \formula phi;
        \schemaVar \formula #observation;
        \schemaVar \formula #stateFml;
        \schemaVar \update u;
        \schemaVar \term int i;
        \find(==> {u}\<{}\>(phi ** `#stateFml`))
        \varcond(\postStateCondition(phi,#stateFml),\not\containsObservations(phi))
        \replacewith(==>#stateFml);
        \replacewith(==> {u}\<{}\>(phi))
        \heuristics(simplify)
    };
    postStateConc{
        \schemaVar \formula phi;
        \schemaVar \formula #observation;
        \schemaVar \formula #stateFml;
        \schemaVar \update u;
        \schemaVar \term int i;
        \find(==> {u}\<{}\>(phi $. `#stateFml`))
        \varcond(\postStateCondition(phi,#stateFml),\not\containsObservations(phi))
        \replacewith(==>#stateFml);
        \replacewith(==> {u}\<{}\>(phi $. `true`))
        \heuristics(simplify)
    };
    // manual rule application
    trivialConcR{
        \find(~~ $. `true`)
        \replacewith(~~)
        \heuristics(simplify)
    };
//    trivialConcL{
//            \find(`true` $. ~~)
//            \replacewith(~~)
//            \heuristics(simplify)
//        };
//    trivialChopR{
//        \schemaVar \formula phi;
//        \find(phi ** `true`)
//        \replacewith(phi)
//        \heuristics(simplify)
//    };
//
//    trivialChopL{
//        \schemaVar \formula phi;
//        \find(`true` ** phi)
//        \replacewith(phi)
//        \heuristics(simplify)
//    };

    trivialChop{
        \find(~~ ** ~~)
        \replacewith(~~)
        \heuristics(simplify)
    };
    applyLocalRules{
        \schemaVar \formula phi;
        \schemaVar \update u;

        \find(==> {u}\<{}\>(phi))
            \addrules(

                chopTrueR{
                    \schemaVar \formula phi1;
                    \find(phi1 ** `true`)
                    \replacewith(phi1)
                    \heuristics(simplify)
                },
                chopTrueL{
                    \schemaVar \formula phi1;
                    \find(`true` ** phi1)
                    \replacewith(phi1)
                    \heuristics(simplify)
                }

                )
        \heuristics(simplify)
    };

    trivialAndL{
        \schemaVar \formula phi;
        \find(~~ & phi)
        \replacewith(phi)
        \heuristics(simplify)
    };

    trivialAndR{
        \schemaVar \formula phi;
        \find(phi & ~~)
        \replacewith(phi)
        \heuristics(simplify)
    };

    expandTrivialTrace{
        \find(~~)
        \replacewith(~~ ** ~~)
    };

    elimPre {
        \schemaVar \formula tracePrefix, tracePostfix, traceFull;
        \schemaVar \update fullUpdate,updatePrefix,updatePostfix;
        \assumes({updatePrefix}\<{}\>(tracePrefix)==>)
        \find(==> {fullUpdate}\<{}\>(traceFull))
        \varcond(\updateStartsWith(fullUpdate,updatePrefix, updatePostfix, traceFull, tracePrefix, tracePostfix),\not\containsObservations(tracePostfix))
        \replacewith(==> {updatePostfix}\<{}\>(tracePostfix))
        \heuristics(simplify)
    };

//    elimPreConc {
//        \schemaVar \formula phi, phi1;
//        \schemaVar \update u,updatePrefix,postfix;
//        \assumes({updatePrefix}\<{}\>(phi)==>)
//        \find(==> {u}\<{}\>(phi $. phi1))
//        \varcond(\updateStartsWith(u,updatePrefix,postfix),\not\containsObservations(phi1))
//        \replacewith(==> {postfix}\<{}\>(phi1))
//        \heuristics(simplify)
//    };

    trivialConcTrue{
        \schemaVar \update u;
        \find(==> {u}\<{}\>(~~ $. `true`))
        \replacewith(==> {u}\<{}\>(~~))
        \heuristics(simplify)
    };

    schematicTraceConcTrue{
        \schemaVar \formula phi;
        \schemaVar \update u;
        \find(==> {u}\<{}\>(phi $. `true`))
        \varcond(\isSchematicTrace(phi))
        \replacewith(==> {u}\<{}\>(phi))
        \heuristics(simplify)
    };

    and{
        \schemaVar \formula phi,phi1;
        \schemaVar \update u;
        \find(==> {u}\<{}\>(phi & phi1))
        \replacewith(==> {u}\<{}\>(phi));
        \replacewith(==> {u}\<{}\>(phi1))
        \heuristics(simplify)
    };

    elimStartEvSchemTr{
        \schemaVar \formula phi;
        \schemaVar \program MethodName methodName;
        \schemaVar \update u;
        \find(==> {\startEv(methodName,0)}\<{}\>(phi))
        \varcond(\isSchematicTrace(phi))
        \closegoal
        \displayname "Elim StartEv SchemTr"
        \heuristics(closure)
    };

    elimPopEvSchemTr{
        \schemaVar \formula phi;
        \schemaVar \program MethodName methodName;
        \schemaVar \update u;
        \find(==> {u;\popEv(methodName,0)}\<{}\>(phi))
        \varcond(\isSchematicTrace(phi))
        \replacewith(==> {u}\<{}\>(phi))
        \heuristics(simplify)
    };

    elimRunEvSchemTr{
        \schemaVar \formula phi;
        \schemaVar \program MethodName methodName;
        \schemaVar \update u;
        \schemaVar \term int i;
        \schemaVar \term boolean sync;
        \find(==> {u;\runEv(methodName,i,sync)}\<{}\>(phi))
        \varcond(\isSchematicTrace(phi), \not\isSchematicTraceOverM(phi, methodName))
        \replacewith(==> {u}\<{}\>(phi))
        \heuristics(simplify)
    };

    elimRetEvSchemTr{
        \schemaVar \formula phi;
        \schemaVar \update u;
        \find(==> {u;\retEv(0)}\<{}\>(phi))
        \varcond(\isSchematicTrace(phi))
        \replacewith(==> {u}\<{}\>(phi))
        \heuristics(simplify)
    };

    elimAssignEvSchemTrLeadingUpdate{
        \schemaVar \formula phi;
        \schemaVar \update u;
        \find(==> {u;#loc := #se}\<{}\>(phi))
        \varcond(\isSchematicTrace(phi))
        \replacewith(==> {u}\<{}\>(phi))
        \heuristics(simplify)
    };

    elimAssignEvSchemTr{
        \schemaVar \formula phi;
        \schemaVar \update u;
        \find(==> {#loc := #se}\<{}\>(phi))
        \varcond(\isSchematicTrace(phi))
        \closegoal
        \heuristics(simplify)
    };


    elimMatchingPopEv{
        \schemaVar \formula phi,phi1;
        \schemaVar \term MethodName #mn;
        \schemaVar \update u;
        \schemaVar \term int #i;
        \find(==> {u;\popEv(#mn,#i)}\<{}\>(phi **\popTrEv(#mn,#i)))
        \replacewith(==> {u}\<{}\>(phi))
        \heuristics(simplify)
    };


}

\rules(programRules:CAT){

    bindContractSuccedent{
        \schemaVar \variable Z y;
        \schemaVar \formula phi;
        \schemaVar \program MethodName #mn;
        \find(CATof(#mn, bind{y;}(phi)))
        \varcond(\newDependingOn(observingSk, phi))
        \replacewith(CATof(#mn,{\subst y; observingSk}phi))
        \heuristics(simplify)
    };

    applyContract{

        \schemaVar \formula pre_trace, inner_trace,post_trace,stateFml;
        \schemaVar \update u;
        \schemaVar \program MethodName #mn;
        \schemaVar \term MethodName methodName;
        \find(==> \[{.. #t.#mn(true); ...}\]applyContract(u, CATof(methodName,CAT(pre_trace**`stateFml`,inner_trace,post_trace))))
        \varcond(\methodNameConstant(#t, #mn, methodName))
        \replacewith(==>{u;\startEv(methodName,0)} \[{#method-call(#t.#mn(true));}\](pre_trace **`stateFml` **  inner_trace))
        \add(
            {\startEv(methodName,0)}\<{}\>(\startTrEv(methodName,0)),
            stateFml,
             {u}\<{}\>(pre_trace**`stateFml`)

            ==>)
        \heuristics(simplify_prog)
    };

    startObservingForContract{
        \schemaVar \formula #observation;
        \schemaVar \formula stateFml;
        \schemaVar \formula pre_trace, inner_trace,post_trace;
        \schemaVar \term Z observed, observing;
        \schemaVar \program MethodName #mn;
        \schemaVar \term MethodName methodName;
        \schemaVar \skolemTerm int anonId;
        \find(==> \[{.. #t.#mn(true); ...}\]CATof(methodName,CAT(pre_trace,inner_trace,post_trace)))
        \varcond(\methodNameConstant(#t, #mn, methodName))
        \replacewith(==> \[{.. #t.#mn(true); ...}\]observe(\havoc(anonId),CATof(methodName,CAT(pre_trace,inner_trace,post_trace))))
        \heuristics(simplify_prog)
    };


    observeInPreTrace{
        \schemaVar \formula #obs;
        \schemaVar \formula stateFml;
        \schemaVar \formula pre_trace, inner_trace,post_trace;
        \schemaVar \term Z observed, observing;
        \schemaVar \program MethodName #mn;
        \schemaVar \term MethodName methodName;
        \schemaVar \update u;
        \find(observe(u, CATof(methodName, CAT(pre_trace $. (#obs $. `stateFml`),inner_trace,post_trace))))
        \varcond(
            \observationCondition(#obs, observed, observing)
            )
        \replacewith(observe(u, CATof(methodName, CAT(pre_trace $.  `stateFml`,inner_trace,post_trace))))
        \add(({u} observed) = observing ==>)
        \heuristics(simplify_prog)
    };

    lastObservationInPreTrace{
        \schemaVar \formula #obs;
        \schemaVar \formula stateFml;
        \schemaVar \formula pre_trace, inner_trace,post_trace;
        \schemaVar \term Z observed, observing;
        \schemaVar \program MethodName #mn;
        \schemaVar \term MethodName methodName;
        \schemaVar \update u;
        \find(observe(u, CATof(methodName, CAT((pre_trace ** #obs) $. `stateFml`,inner_trace,post_trace))))
        \varcond(
            \observationCondition(#obs, observed, observing)
            )
        \replacewith(applyContract(u, CATof(methodName, CAT(pre_trace **  `stateFml`,inner_trace,post_trace))))
        \add(({u} observed) = observing ==>)
        \heuristics(simplify_prog)
    };


    contract{
        \schemaVar \formula pre_trace, inner_trace,post_trace;
        \schemaVar \program MethodName #mn;
        \schemaVar \term MethodName methodName;
        \schemaVar \skolemTerm int anonId;
        \find(==> CATof(methodName, CAT(pre_trace,inner_trace,post_trace)))
        \varcond(\methodNameConstant(#t, #mn, methodName))
        \replacewith(==>\[{#t.#mn(true);}\]CATof(methodName,CAT(pre_trace,inner_trace,post_trace)))
        \heuristics(simplify_prog)
        \displayname "contract"
    };

    methodBodyExpand {
        \schemaVar \program NonModelMethodBody #mb;
        \schemaVar \skolemTerm int anonId;
        \schemaVar \update u;
        \schemaVar \program Variable sync;
        \find({u;sync:=TRUE}\modality{#globalJudge}{.. #mb ...}\endmodality (post))
        \replacewith({u}\modality{#globalJudge}{.. #expand-method-body(#mb); ...}\endmodality (post))
        \heuristics(simplify_prog)
    };

//    compound_assignment_op_plus {
//        \find(\modality{#globalJudge}{.. #lhs += #e; ...}\endmodality (post))
//        \replacewith(\modality{#globalJudge}{.. #lhs = (#typeof(#lhs))(#lhs + (#e)); ...}\endmodality (post))
//        \heuristics(simplify_prog)
//    };

    variableDeclarationAssign {
        \schemaVar \program VariableInitializer #vi;
        \find(\modality{#globalJudge}{.. #t #v0 = #vi; ...}\endmodality (post))
        \replacewith(\modality{#globalJudge}{.. #t #v0; #v0 = #vi; ...}\endmodality (post))
        \heuristics(simplify_prog, simplify_prog_subset)
        \displayname "variableDeclaration"
    };


}

\rules(programRules:CAT){

    return{
        \find(\[{.. return;...}\](post))
        \replacewith({\retEv(0)}\[{}\](post))
        \heuristics(simplify_prog, simplify_prog_subset)
        \displayname "return"

    };

    separator{
        \schemaVar \formula phi,phi1;

        \find(phi ** phi1)
        \replacewith(phi $. phi1)
    };

    scheduleTmp {
        \schemaVar \update #u;
        \schemaVar \program MethodName methodName;
        \schemaVar \skolemTerm int callId;
        \find({#u}\modality{#globalJudge}{}\endmodality(post))
        \varcond(\pendingInvocationCondition(#u, methodName, callId))
        \replacewith({#u;\runEv(methodName,callId,FALSE)}\modality{#globalJudge}{}\endmodality(post))
        \displayname "scheduleTmp"
        \heuristics(simplify_prog, simplify_prog_subset)
    };

    finish {
        \schemaVar \update #u;
        \schemaVar \program MethodName methodName;
        \schemaVar \skolemTerm int callId;
        \find(==> {#u}\[{}\](post))
        \varcond(\finishCondition(#u,methodName))
        \replacewith(==> {#u;\popEv(methodName,0)}\<{}\>(post))
        \displayname "finish"
        \heuristics(simplify_prog)
    };


    invoc {
        \schemaVar \term MethodName methodName;
        \schemaVar \skolemTerm int callId;
        \schemaVar \program MethodName #mn;  // wrong sort in general, need better one
        \find(\modality{#globalJudge}{.. #t.#mn(false); ...}\endmodality(post))
        \varcond(\methodNameConstant(#t, #mn, methodName))
        \replacewith({\invocEv(methodName,callId)}\modality{#globalJudge}{.. ...}\endmodality(post))
        \heuristics(simplify_prog, simplify_prog_subset)
    };

    pre_Call {
        \schemaVar \term MethodName methodName;
        \schemaVar \formula phi, contract;
        \schemaVar \program MethodName #mn;  // wrong sort in general, need better one
        \schemaVar \update u;

        \assumes(assumeCATof(methodName, contract) ==>)
        \find(==> {u}\[{.. #t.#mn(true); ...}\](phi))

        \varcond(\methodNameConstant(#t, #mn, methodName))

        \replacewith(==> contractApplication(holdBindingCATof(methodName, contract),{u}\[{.. #t.#mn(true); ...}\](phi)))

        \heuristics(simplify_prog, simplify_prog_subset)
    };

    call {
        \schemaVar \term MethodName methodName;
        \schemaVar \formula #observation;
        \schemaVar \skolemTerm int callId;
        \schemaVar \formula pre_trace, inner_trace,post_trace;
        \schemaVar \formula fullFormula, preFormula, innerFormula, postFormula,phi;
        \schemaVar \formula stateFml,stateFml1;
        \schemaVar \term Z observed;
        \schemaVar \term Z observing;
        \schemaVar \program MethodName #mn;  // wrong sort in general, need better one
        \schemaVar \update u;
        \schemaVar \skolemTerm int anonId;
//        \assumes({u}\<{}\>(preFormula) ==>)
        \find(==> contractApplication(
            CATof(methodName, CAT((pre_trace** #observation) $. `stateFml`,inner_trace,post_trace)),
            {u}\[{.. #t.#mn(true); ...}\](fullFormula)))

        \varcond(\observationCondition(#observation, observed, observing),\methodNameConstant(#t, #mn, methodName),
            \chopForCall(fullFormula, preFormula, innerFormula, postFormula))


        "Pre-trace":
        \replacewith(==>{u} \<{}\>((pre_trace $. `stateFml`) & preFormula))
        \add(({u}observed)=observing==>);

        "Inner behavior implication":
        \replacewith(==> {\havoc(anonId)} \<{}\> innerFormula)
        \add(({u}observed)=observing, {\havoc(anonId)}\<{}\> inner_trace ==>);

        "Continue":
        \replacewith(==> {u; \runEv(methodName,callId,TRUE)} \[{.. ...}\](
            ((pre_trace $. `stateFml`) & preFormula) ** inner_trace ** (post_trace & (postFormula))
            ))
        \add(({u}observed)=observing,{u; \runEv(methodName,callId,TRUE)}\<{}\>(((pre_trace $. `stateFml`) & preFormula) ** inner_trace) ==>)

        // INNER BEHAVIOR IMPLICATION
        // CONTINUE
//        \heuristics(simplify_prog, simplify_prog_subset)
    };

    callWithAdd {
        \schemaVar \term MethodName methodName;
        \schemaVar \formula cat;
        \schemaVar \formula fullFormula, preFormula, innerFormula, postFormula;
        \schemaVar \program MethodName #mn;  // wrong sort in general, need better one
        \schemaVar \update u;
        \find(==> contractApplication(
            holdBindingCATof(methodName, cat), {u}\[{.. #t.#mn(true); ...}\](fullFormula)))

        \varcond(\methodNameConstant(#t, #mn, methodName))

        "Pre-trace":
        \add(==> preTrace(
            contractApplication(CATof(methodName, cat), {u}\[{.. #t.#mn(true); ...}\](fullFormula)),
            preFormula));

        "Inner behavior implication":
        \add(==>innerBehavior(
            contractApplication(CATof(methodName, cat), {u}\[{.. #t.#mn(true); ...}\](fullFormula)),
            innerFormula));

        "Continue":
        \add(==> continue(
            contractApplication(CATof(methodName, cat), {u}\[{.. #t.#mn(true); ...}\](fullFormula)),
            preFormula,
            postFormula))

        \heuristics(traceCall)
    };

    callPreTraceBranch {
        \schemaVar \term MethodName methodName;
        \schemaVar \formula #observation;
        \schemaVar \skolemTerm int callId;
        \schemaVar \formula pre_trace, inner_trace,post_trace;
        \schemaVar \formula phi, preFormula;
        \schemaVar \formula stateFml,stateFml1;
        \schemaVar \term Z observed;
        \schemaVar \term Z observing;
        \schemaVar \program MethodName #mn;  // wrong sort in general, need better one
        \schemaVar \update u;
        \schemaVar \skolemTerm int anonId;
        \find(==>
            preTrace(
                contractApplication(CATof(methodName, CAT((pre_trace** #observation) $. `stateFml`,inner_trace,post_trace)),{u}(phi)),
                preFormula
            )
        )

        \varcond(\observationCondition(#observation, observed, observing))

        \replacewith(({u}observed)=observing==>{u} \<{}\>((pre_trace $. `stateFml`) & preFormula))

        \heuristics(simplify)
    };

    callInnerBehaviorBranch{

        \schemaVar \term MethodName methodName;
        \schemaVar \formula #observation;
        \schemaVar \formula pre_trace, inner_trace,post_trace;
        \schemaVar \formula innerFormula,phi;
        \schemaVar \formula stateFml;
        \schemaVar \term Z observed;
        \schemaVar \term Z observing;
        \schemaVar \update u;
        \schemaVar \skolemTerm int anonId;
        \find(==>
            innerBehavior(
                contractApplication(CATof(methodName, CAT((pre_trace** #observation) $. `stateFml`,inner_trace,post_trace)),{u}(phi)),
                innerFormula))


        \varcond(\observationCondition(#observation, observed, observing))

        \replacewith(({u}observed)=observing, {\havoc(anonId)}\<{}\> inner_trace ==> {\havoc(anonId)} \<{}\> innerFormula)

        \heuristics(simplify)

    };

    assocChopAnd{
        \schemaVar \formula phi1, phi2, phi3;
        \find((phi1 & phi2) ** phi3)
        \replacewith((phi1 ** phi3) & (phi2** phi3))
    };

    assocConcAndR{
        \schemaVar \formula phi1, phi2, phi3;
        \find((phi1 & phi2) $. phi3)
        \replacewith((phi1 $. phi3) & (phi2 $. phi3))
    };


    assocConcAndL{
        \schemaVar \formula phi1, phi2, phi3;
        \find(phi1 $. (phi2 & phi3))
        \replacewith((phi1 $. phi2) & (phi1 $. phi3))
    };

    callContinueBranch{
        \schemaVar \term MethodName methodName;
        \schemaVar \formula #observation;
        \schemaVar \skolemTerm int callId;
        \schemaVar \formula pre_trace, inner_trace,post_trace;
        \schemaVar \formula fullFormula, preFormula, postFormula;
        \schemaVar \formula stateFml,stateFml1;
        \schemaVar \term Z observed;
        \schemaVar \term Z observing;
        \schemaVar \program MethodName #mn;  // wrong sort in general, need better one
        \schemaVar \update u;
        \find(==>
            continue(
                contractApplication(CATof(methodName, CAT((pre_trace** #observation) $. `stateFml`,inner_trace,post_trace)),{u}\[{.. #t.#mn(true); ...}\](fullFormula)),
                preFormula,
                postFormula
            )
        )

        \varcond(\observationCondition(#observation, observed, observing),\methodNameConstant(#t, #mn, methodName))

        \replacewith(({u}observed)=observing,{u; \runEv(methodName,callId,TRUE)}\<{}\>(((pre_trace $. `stateFml`) & preFormula) ** inner_trace)
            ==>
            {u; \runEv(methodName,callId,TRUE)} \[{.. ...}\](
                        ((pre_trace $. `stateFml`) & preFormula) ** inner_trace ** (post_trace & (postFormula))
                        )
            )
        \heuristics(simplify)
    };


    callManual {
        \schemaVar \term MethodName methodName;
        \schemaVar \formula #observation;
        \schemaVar \skolemTerm int callId;
        \schemaVar \formula pre_trace, inner_trace,post_trace;
        \schemaVar \formula fullFormula, preFormula, innerFormula, postFormula,phi;
        \schemaVar \formula stateFml,stateFml1;
        \schemaVar \term Z observed;
        \schemaVar \term Z observing;
        \schemaVar \program MethodName #mn;  // wrong sort in general, need better one
        \schemaVar \update u;
        \schemaVar \skolemTerm int anonId;
//        \assumes({u}\<{}\>(preFormula) ==>)
        \find(==> contractApplication(
            CATof(methodName, CAT((pre_trace** #observation) $. `stateFml`,inner_trace,post_trace)),
            {u}\[{.. #t.#mn(true); ...}\](preFormula ** innerFormula ** postFormula )))

        \varcond(\observationCondition(#observation, observed, observing),\methodNameConstant(#t, #mn, methodName))

        "Pre-trace":
        \replacewith(==>{u} \<{}\>((pre_trace $. `stateFml`) & preFormula))
        \add(({u}observed)=observing==>);

        "Inner behavior implication":
        \replacewith(==> {\havoc(anonId)} \<{}\> innerFormula)
        \add(({u}observed)=observing, {\havoc(anonId)}\<{}\> inner_trace ==>);

        "Continue":
        \replacewith(==> {u; \runEv(methodName,callId,TRUE)} \[{.. ...}\](
            ((pre_trace $. `stateFml`) & preFormula) ** inner_trace ** (post_trace & (postFormula))
            ))
        \add(({u}observed)=observing,{u; \runEv(methodName,callId,TRUE)}\<{}\>(((pre_trace $. `stateFml`) & preFormula) ** inner_trace) ==>)

    };

    assign {
        \find(\modality{#globalJudge}{.. #loc = #se; ...}\endmodality (post))
        \replacewith({#loc := #se}\modality{#globalJudge}{.. ...}\endmodality (post))
        \heuristics(simplify_prog, simplify_prog_subset)
        \displayname "assign"
    };

    assignThis {
            \find(\modality{#globalJudge}{.. this.#loc = #se; ...}\endmodality (post))
            \replacewith({#loc := #se}\modality{#globalJudge}{.. ...}\endmodality (post))
            \heuristics(simplify_prog, simplify_prog_subset)
            \displayname "assign"
    };

    ifUnfold {
        \find(\modality{#globalJudge}{.. if(#nse) #s0 ...}\endmodality (post))
        \varcond(\new(#boolv, boolean))
        \replacewith(\modality{#globalJudge}{.. boolean #boolv; #boolv = #nse; if(#boolv) #s0 ...}\endmodality (post))
        \heuristics(simplify_prog)
        \displayname "ifElseUnfold"
    };

    ifElseUnfold {
        \find(\modality{#globalJudge}{.. if(#nse) #s0 else #s1 ...}\endmodality (post))
        \varcond(\new(#boolv, boolean))
        \replacewith(\modality{#globalJudge}{.. boolean #boolv; #boolv = #nse; if(#boolv) #s0 else{#s1}
                ...}\endmodality (post))
        \heuristics(simplify_autoname)
        \displayname "ifElseUnfold"
    };

    if {
        \find(\modality{#globalJudge}{.. if(#se) #s0  ...}\endmodality (post))
        \replacewith(\if(#se = TRUE) \then(\modality{#globalJudge}{.. #s0 ...}\endmodality (post))
                \else(\modality{#globalJudge}{.. ...}\endmodality (post)))
        // \heuristics(split_if)
        \displayname "ifElse"
    };

    ifElse {
        \find(\modality{#globalJudge}{.. if(#se) #s0 else #s1 ...}\endmodality (post))
        \replacewith(\if(#se = TRUE) \then(\modality{#globalJudge}{.. #s0 ...}\endmodality (post))
                \else(\modality{#globalJudge}{.. #s1 ...}\endmodality (post)))
        // \heuristics(split_if)
        \displayname "ifElse"
    };

    ifElseSplit {
        \find( ==> \modality{#globalJudge}{.. if(#se) #s0 else #s1 ...}\endmodality (post))
        "if #se true":
            \replacewith( ==> \modality{#globalJudge}{.. #s0 ...}\endmodality (post)) \add(#se = TRUE ==>);
        "if #se false":
            \replacewith( ==> \modality{#globalJudge}{.. #s1 ...}\endmodality (post)) \add(#se = FALSE ==>)
        \heuristics(split_if)
        \displayname "ifElseSplit"
    };

    ifSplit {
        \find( ==> \modality{#globalJudge}{.. if(#se) #s0  ...}\endmodality (post))
        "if #se true":
            \replacewith( ==> \modality{#globalJudge}{.. #s0 ...}\endmodality (post)) \add(#se = TRUE ==>);
        "if #se false":
            \replacewith( ==> \modality{#globalJudge}{..  ...}\endmodality (post)) \add(#se = FALSE ==>)
        \heuristics(split_if)
        \displayname "ifElseSplit"
    };

    ifElseSplitLeft {
        \find(\modality{#globalJudge}{.. if(#se) #s0 else #s1 ...}\endmodality (post) ==>)
        \replacewith(\modality{#globalJudge}{.. #s0 ...}\endmodality (post) ==>) \add(#se = TRUE ==>);
        \replacewith(\modality{#globalJudge}{.. #s1 ...}\endmodality (post) ==>) \add(#se = FALSE ==>) \heuristics(split_if)
    };

    ifSplitLeft {
        \find(\modality{#globalJudge}{.. if(#se) #s0  ...}\endmodality (post) ==>)
        \replacewith(\modality{#globalJudge}{.. #s0 ...}\endmodality (post) ==>) \add(#se = TRUE ==>);
        \replacewith(\modality{#globalJudge}{..  ...}\endmodality (post) ==>) \add(#se = FALSE ==>) \heuristics(split_if)
    };

    ifTrue {
        \assumes(#se = TRUE ==>)
        \find( ==> \modality{#globalJudge}{.. if (#se) #s0 ...}\endmodality (post))
        \replacewith( ==> \modality{#globalJudge}{.. #s0 ...}\endmodality (post))
        \heuristics(simplify_prog)
    };

    ifElseTrue {
        \assumes(#se = TRUE ==>)
        \find( ==> \modality{#globalJudge}{.. if (#se) #s0 else #s1 ...}\endmodality (post))
        \replacewith( ==> \modality{#globalJudge}{.. #s0 ...}\endmodality (post))
        \heuristics(simplify_prog)
    };

    ifFalse {
        \assumes(#se = FALSE ==>)
        \find( ==> \modality{#globalJudge}{.. if (#se) #s0 ...}\endmodality (post))
        \replacewith( ==> \modality{#globalJudge}{.. ...}\endmodality (post))
        \heuristics(simplify_prog)
    };

    ifElseFalse {
        \assumes(#se = FALSE ==>)
        \find( ==> \modality{#globalJudge}{.. if (#se) #s0 else #s1 ...}\endmodality (post))
        \replacewith( ==> \modality{#globalJudge}{.. #s1 ...}\endmodality (post))
        \heuristics(simplify_prog)
    };

    ifEnterThen {
        \find(\modality{#globalJudge}{.. #loc=true; if (#loc) #s0 ...}\endmodality (post))
        \replacewith(\modality{#globalJudge}{.. #loc=true; #s0 ...}\endmodality (post))
        \heuristics(simplify)
    };

    ifSkipThen {
        \find(\modality{#globalJudge}{.. #loc=false; if (#loc) #s0 ...}\endmodality (post))
        \replacewith(\modality{#globalJudge}{.. #loc=false; ...}\endmodality (post))
        \heuristics(simplify)
    };

    ifElseSkipElse {
        \find(\modality{#globalJudge}{.. #loc=true; if (#loc) #s0 else #s1 ...}\endmodality (post))
        \replacewith(\modality{#globalJudge}{.. #loc=true; #s0 ...}\endmodality (post))
        \heuristics(simplify)
    };

    ifElseSkipThen {
        \find(\modality{#globalJudge}{.. #loc=false; if (#loc) #s0 else #s1 ...}\endmodality (post))
        \replacewith(\modality{#globalJudge}{.. #loc=false; #s1 ...}\endmodality (post))
        \heuristics(simplify)
    };

    variableDeclaration {
        \find(\modality{#globalJudge}{.. #t #v0; ...}\endmodality (post))
        \replacewith(\modality{#globalJudge}{..  ...}\endmodality (post))
        \addprogvars(#v0)
        \heuristics(simplify_prog, simplify_prog_subset)
        \displayname "variableDeclaration"
    };

    equality_comparison_simple {
        \find(\modality{#globalJudge}{.. #lhs = #senf0 == #senf1; ...}\endmodality (post))
        \replacewith({#lhs := \if(#senf0 = #senf1) \then(TRUE) \else(FALSE)}
            \modality{#globalJudge}{.. ...}\endmodality (post))
        \heuristics(simplify_prog)
        \displayname "equality comparison"
    };

    eval_order_access4_this {
        \schemaVar \program StaticVariable #staticA;
        \find(\modality{#globalJudge}{.. #staticA=#nse; ...}\endmodality (post))
        \varcond(\newTypeOf(#v, #nse))
        \replacewith(\modality{#globalJudge}{..
                #typeof(#nse) #v=#nse;
                #staticA=#v;...}\endmodality (post))
        \heuristics(simplify_prog, simplify_prog_subset)
        \displayname "assignmentSaveLocationThis"
    };

