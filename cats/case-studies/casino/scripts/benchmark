sh key4cats -b -s oneRoundCAT -catsl $THIS_PATH/casino.cats -java Casino -stats
echo "BENCHMARK wrongRoundCAT"
sh key4cats -b -s wrongRoundCAT -catsl $THIS_PATH/casino.cats -java Casino -stats
