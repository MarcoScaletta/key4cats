#!/bin/sh

if [[ -z "${KEY}" ]]; then
  echo "\033[1;31m ERROR: Env. Variable KEY not defined\033[0m"
  exit 1
fi


THIS_PATH=$KEY/cats/case-studies/removeOneCaseStudy/resources/

echo "BENCHMARK removeOneOnceCAT"
sh key4cats -b -s removeOneOnceCAT -catsl $THIS_PATH/removeOneCaseStudy.cats -java RemoveOneCaseStudy -stats
echo "BENCHMARK removeOneTwiceCAT"
sh key4cats -b -s removeOneTwiceCAT -catsl $THIS_PATH/removeOneCaseStudy.cats -java RemoveOneCaseStudy -stats
echo "Verifying removeOneThriceCAT WITHOUT JVM warmup (warmup of JVM is not necessary)"
sh key4cats -s removeOneThriceCAT -catsl $THIS_PATH/removeOneCaseStudy.cats -java RemoveOneCaseStudy -stats
echo "Verifying removeOneQuadCAT WITHOUT JVM warmup"
echo "\033[1;31m !! JVM warmup for this CAT is unnecessary and NOT RECOMMENDED !!\033[0m"
echo "The proof will be done interactively (remove -i, otherwise)"
sh key4cats -i -s removeOneQuadCAT -catsl $THIS_PATH/removeOneCaseStudy.cats -java RemoveOneCaseStudy
