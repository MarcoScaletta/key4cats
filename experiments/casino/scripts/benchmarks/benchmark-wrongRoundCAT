#!/bin/sh


if [[ -z "${KEY4CATs}" ]]; then
  echo "Env. Variable KEY4CATs not defined: set it as the path to executable \"KeY4CATs.jar\""
  exit 1
fi

alias key4cats="java -jar \$KEY4CATs $@"

THIS_PATH=../../resources/

echo "BENCHMARK wrongRoundCAT: proof should fail"
key4cats -b -s wrongRoundCAT -catsl $THIS_PATH/casino.cats -java Casino -stats
